<!DOCTYPE html>
<html lang="ko">
  <head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
      
  <title>결제 성공 (Ruby On Rails)</title>
</head>
    
<body>
    
<section>
    <% if @Response["code"] %>
    <h1>가상계좌 발급 실패</h1>
    <p>에러코드 : <%= @Response["code"] %></p>
    <p>에러메시지 : <%= @Response["message"] %></p>
    <% else %>
    <h1>결제 성공</h1>
    
    <p>orderName : <%=@Response["orderName"]%></p>
    <p>method : <%=@Response["method"]%></p>
    <p>virtualAccount -> accountNumber : <%= @Response.dig("virtualAccount", "accountNumber") %></p>
    <p>virtualAccount -> bank : <%= @Response.dig("virtualAccount", "bank") %></p>
    <% end %>
    <br><br>
    
    <br>
    
</section> 

<button class="button is-link" onclick="location.href='/payment/vaapi';">돌아가기</button>
    
</body>
</html>